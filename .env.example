# Public local endpoints
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
CHECKOUT_MCP_URL=http://127.0.0.1:8941/mcp
PAGERPILOT_OPERATOR_URL=http://127.0.0.1:4173
# Must match a model name listed by GET /api/v1/models on your TrueForge server
TRUEFORGE_MODEL=openai/gpt-5-6-sol
DAYTONA_API_URL=https://app.daytona.io/api

# Reusable skill source: a pushed repository and a full 40-character commit SHA
PAGERPILOT_SKILL_REPOSITORY_URL=https://github.com/hharshhsaini/pagerpilot.git
PAGERPILOT_SKILL_REPOSITORY_REF=
PAGERPILOT_SKILL_REPOSITORY_PATH=skills/pagerpilot-runbook
PAGERPILOT_BOOTSTRAP_OUTPUT=.pagerpilot/bootstrap.json
PAGERPILOT_SESSION_STATE=.pagerpilot/session.json
PAGERPILOT_AGENT_NAME=pagerpilot-incident-responder
# Printed as agent.id by the bootstrap script
VITE_PAGERPILOT_AGENT_ID=

# Optional authentication for an OIDC-enabled TrueForge server
TRUEFORGE_TOKEN=

# External providers; supply only in an ignored .env file or secret manager
OPENAI_API_KEY=
DAYTONA_API_KEY=
GITHUB_TOKEN=
GITHUB_DEMO_TOKEN=
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Non-secret connector configuration
DAYTONA_SNAPSHOT=
SLACK_CHANNEL_ID=
SLACK_CHANNEL=pagerpilot-demo
EVIDENCE_RUN_ID=local
